filters:
  and:
    - 'file.ext == "md"'
    - 'review_by != null'
properties:
  file.name:
    displayName: Note
  type:
    displayName: Type
  last_verified:
    displayName: Last verified
  review_by:
    displayName: Review by
  status:
    displayName: Status
views:
  - type: table
    name: Review queue
    filters:
      and:
        - 'review_by <= today()'
    order:
      - file.name
      - type
      - last_verified
      - review_by
      - status
  - type: table
    name: All dated notes
    order:
      - review_by
      - file.name
      - type
      - last_verified
